{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/expo-env.d.ts",
    "src/nativewind-env.d.ts",
    "nativewind-env.d.ts",
    "app.config.ts",
    "brands/**/*.ts"
  ]
}
